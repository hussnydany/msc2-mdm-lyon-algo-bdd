x


# =============================================================================
# PIPELINE
# =============================================================================
#
# Ce script realise un pipeline complet :
#   1. Connexion a une base MySQL
#   2. Extraction des donnees RFM
#   3. Enrichissement via une API de geocoding
#   4. Visualisation avec matplotlib
#   5. Ecriture des resultats enrichis dans la base
#
# Prerequis :
#   - MySQL installe avec la base ecommerce_rfm (fichier rfm-ecommerce.sql)
#   - La vue view_rfm
#   - pip install mysql-connector-python requests matplotlib pandas
#
# =============================================================================


# -----------------------------------------------------------------------------
# IMPORTS
# -----------------------------------------------------------------------------

import mysql.connector
import pandas as pd
import requests
import time
import matplotlib.pyplot as plt


# Connexion MySQL

conn = mysql.connector.connect(
    host="localhost",
    user="root",
    password="<votre-mot-de-passe>",
    database="ecommerce_rfm"
)
cursor = conn.cursor(dictionary=True)

# Test de connexion 
cursor.execute("SELECT COUNT(*) AS total FROM clients")
resultat = cursor.fetchone()
print(f"Connexion OK - {resultat['total']} clients dans la base")


# -----------------------------------------------------------------------------
#  EXTRACTION - RECUPERER LA VUE RFM
# -----------------------------------------------------------------------------

cursor.execute("SELECT * FROM vue_rfm")
resultats = cursor.fetchall()

# Transformer en DataFrame pandas
df = pd.DataFrame(resultats)
print(f"\n{len(df)} clients segmentes")
print(df)


print("\n--- Stats par segment ---")
stats = df.groupby('segment').agg(
    nb_clients=('nom', 'count'),
    panier_moyen=('montant_total', 'mean'),
    recence_moyenne=('recence_jours', 'mean')
).round(2)
print(stats)


# -----------------------------------------------------------------------------
# ENRICHISSEMENT - APPEL API DE GEOCODING
# -----------------------------------------------------------------------------
# On enrichit nos donnees avec une source externe : l'API Nominatim
# d'OpenStreetMap. Elle prend un nom de ville et renvoie ses coordonnees
# GPS.
#
# En croisant avec des sources externes, on ajoute de
#   l'information. Ici, les coordonnées GPS permettent de visualiser les
#   clients sur une carte et d'analyser la répartition géographique par segment.
#
# requests.get(url, headers) :
#   - url : l'adresse de l'API avec les paramètres (ici le nom de la ville)
#   - headers : des informations supplémentaires. User-Agent identifie notre
#     application. C'est obligatoire pour Nominatim, sinon l'API refuse.
#
# response.json() : transforme la réponse HTTP en objet Python (liste ou
#   dictionnaire).
# time.sleep(1) : attend 1 seconde. L'API Nominatim est gratuite mais
#   limite le nombre de requêtes par seconde.
# -----------------------------------------------------------------------------

def geocoder_ville(ville):
    """
    Prend un nom de ville en entrée.
    Appelle l'API Nominatim pour obtenir les coordonnées GPS.
    Renvoie un tuple (latitude, longitude) ou (None, None) si la ville
    n'est pas trouvée.
    """
    url = f"https://nominatim.openstreetmap.org/search?q={ville},France&format=json&limit=1"
    headers = {"User-Agent": "algo-bdd-cours/1.0"}
    response = requests.get(url, headers=headers)
    data = response.json()
    if data:
        return float(data[0]['lat']), float(data[0]['lon'])
    return None, None


# Test sur une seule ville avant de tout geocoder
lat, lon = geocoder_ville("Lyon")
print(f"\nTest geocoding - Lyon : lat={lat}, lon={lon}")

# Geocoder toutes les villes uniques
villes = df['ville'].unique()
coords = {}
print("\nGeocoding des villes :")
for ville in villes:
    lat, lon = geocoder_ville(ville)
    coords[ville] = {'lat': lat, 'lon': lon}
    print(f"  {ville}: lat={lat}, lon={lon}")
    time.sleep(1)

# Ajouter les coordonnées au DataFrame
# map() applique une fonction à chaque valeur de la colonne.
# lambda v: coords[v]['lat'] dit : pour chaque ville v, va chercher
# sa latitude dans le dictionnaire coords.
df['lat'] = df['ville'].map(lambda v: coords[v]['lat'])
df['lon'] = df['ville'].map(lambda v: coords[v]['lon'])

print("\nDonnées enrichies :")
print(df[['nom', 'ville', 'lat', 'lon']].head())


# -----------------------------------------------------------------------------
#  VISUALISATION - GRAPHIQUES MATPLOTLIB
# -----------------------------------------------------------------------------
#
# Vocabulaire matplotlib :
#   - figure (fig) : le cadre global, comme une feuille de papier
#   - axes (ax) : un graphique individuel dans la figure
#   - subplots(1, 2) : cree une figure avec 1 ligne et 2 colonnes de graphiques
#   - figsize=(14, 5) : taille de la figure en pouces (largeur, hauteur)
#
# Graphique 1 : camembert (pie) pour la repartition des segments
#   - autopct='%1.0f%%' : affiche les pourcentages sans decimale
#
# Graphique 2 : barres (bar) pour le panier moyen par segment
#   - reindex() : force l'ordre des barres (VIP en premier, Endormi en dernier)
#
# savefig() : sauvegarde le graphique en fichier image (PNG)
# show() : affiche le graphique a l'ecran
# -----------------------------------------------------------------------------

# Couleurs associees a chaque segment
colors = {
    'VIP': '#2ecc71',          # vert
    'Fidele': '#3498db',       # bleu
    'A reactiver': '#f39c12',  # orange
    'Endormi': '#e74c3c'       # rouge
}

# --- Graphique 1 : repartition des segments + panier moyen ---
fig, axes = plt.subplots(1, 2, figsize=(14, 5))

# Camembert a gauche
segment_counts = df['segment'].value_counts()
segment_colors = [colors.get(s, '#95a5a6') for s in segment_counts.index]
axes[0].pie(
    segment_counts.values,
    labels=segment_counts.index,
    autopct='%1.0f%%',
    colors=segment_colors,
    startangle=90
)
axes[0].set_title('Repartition des segments')

# Barres a droite
segment_stats = df.groupby('segment')['montant_total'].mean().round(2)
segment_stats = segment_stats.reindex(['VIP', 'Fidele', 'A reactiver', 'Endormi'])
bar_colors = [colors.get(s, '#95a5a6') for s in segment_stats.index]
axes[1].bar(segment_stats.index, segment_stats.values, color=bar_colors)
axes[1].set_title('Panier moyen par segment (EUR)')
axes[1].set_ylabel('EUR')

plt.tight_layout()
plt.savefig('rfm_segments.png', dpi=150)
# plt.show()  # decommenter pour afficher a l'ecran
print("Graphique sauvegarde : rfm_segments.png")


# --- Graphique 2 : carte des clients par segment ---
# scatter() place des points sur un graphique x/y.
# Ici x = longitude, y = latitude. Ce n'est pas une vraie carte
# geographique mais ca donne une idee de la repartition spatiale.
# annotate() ajoute du texte a cote d'un point, ici le nom de la ville.
fig, ax = plt.subplots(figsize=(10, 8))

for segment in ['VIP', 'Fidele', 'A reactiver', 'Endormi']:
    subset = df[df['segment'] == segment]
    ax.scatter(
        subset['lon'], subset['lat'],
        label=segment,
        c=colors.get(segment),
        s=100,       # taille des points
        alpha=0.7    # transparence (0 = invisible, 1 = opaque)
    )

# Ajouter les noms de villes a coté des points
for ville in df['ville'].unique():
    row = df[df['ville'] == ville].iloc[0]
    ax.annotate(
        ville,
        (row['lon'], row['lat']),
        textcoords="offset points",
        xytext=(5, 5),
        fontsize=8
    )

ax.set_title('Clients par segment et localisation')
ax.set_xlabel('Longitude')
ax.set_ylabel('Latitude')
ax.legend()
plt.tight_layout()
plt.savefig('rfm_carte.png', dpi=150)
# plt.show()  # decommenter pour afficher a l'ecran
print("Carte sauvegardee : rfm_carte.png")


# -----------------------------------------------------------------------------
# ECRITURE EN BASE - SAUVEGARDER LES RESULTATS ENRICHIS
# -----------------------------------------------------------------------------
# On ecrit les resultats enrichis avec les coordonnées GPS dans une
# nouvelle table MySQL, pour y avoir accès depuis un d'autre outil.
#
# cursor.execute() avec %s : les %s sont des placeholders. MySQL les
#   remplace par les valeurs du tuple passe en deuxieme argument. C'est
#   plus sur que de concatener des strings (ca protege contre les
#   injections SQL).
#
# conn.commit() : valide les modifications. Sans commit, les INSERT ne
#   sont pas sauvegardes. MySQL fonctionne en mode transactionnel : les
#   changements sont temporaires tant qu'on ne commit pas.
# -----------------------------------------------------------------------------

cursor.execute("DROP TABLE IF EXISTS rfm_enrichi")
cursor.execute("""
    CREATE TABLE rfm_enrichi (
        nom VARCHAR(100),
        ville VARCHAR(50),
        lat DECIMAL(9,6),
        lon DECIMAL(9,6),
        recence_jours INT,
        frequence INT,
        montant_total DECIMAL(10,2),
        score_r INT,
        score_f INT,
        score_m INT,
        score_total INT,
        segment VARCHAR(20)
    )
""")

# Insérer les donnees ligne par ligne
# iterrows() parcourt le DataFrame ligne par ligne.
for _, row in df.iterrows():
    cursor.execute("""
        INSERT INTO rfm_enrichi
        (nom, ville, lat, lon, recence_jours, frequence, montant_total,
         score_r, score_f, score_m, score_total, segment)
        VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
    """, (
        row['nom'], row['ville'], row['lat'], row['lon'],
        int(row['recence_jours']), int(row['frequence']),
        float(row['montant_total']), int(row['score_r']),
        int(row['score_f']), int(row['score_m']),
        int(row['score_total']), row['segment']
    ))

conn.commit()
print("\nResultats enrichis sauvegardes dans la table rfm_enrichi")


# -----------------------------------------------------------------------------
#  FERMETURE
# -----------------------------------------------------------------------------
# Toujours fermer le cursor et la connexion quand on a fini.
# En entreprise, des connexions qui restent ouvertes peuvent saturer
# le serveur MySQL et bloquer les autres utilisateurs.
# -----------------------------------------------------------------------------

cursor.close()
conn.close()
print("Connexion fermee.")

print("\n=== PIPELINE TERMINE ===")
print("Fichiers generes : rfm_segments.png, rfm_carte.png")
print("Table creee dans MySQL : rfm_enrichi")
print("Lancez maintenant le dashboard : streamlit run dashboard.py")
